  %val = load i8, ptr %x, align 1
  %ext = sext i8 ptrtoint (ptr @abs_sym_8bit to i8) to i32
  %conv = sext i8 %val to i32
  %and = and i32 %conv, %ext
  %tobool = icmp eq i32 %and, 0
  br i1 %tobool, label %if.end, label %if.then
if.then:
  tail call void @xf()
  br label %if.end
if.end:
  ret void
}

declare void @xf()

!0 = !{i64 -1, i64 -1}
!1 = !{i64 -2147483648, i64 2147483648}
