; CHECK-NEXT:    movabsq $abs_sym_in_range, %rax
; CHECK-NEXT:    retq
  %1 = ptrtoint ptr @abs_sym_in_range to i64
  ret i64 %1
}

define void @func_abs_sym_8bit(ptr %x) nounwind {
; CHECK-LABEL: func_abs_sym_8bit:
